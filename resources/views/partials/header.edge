<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
/>

<header class="main-header" id="mainHeader">
  <div class="header-top">
    <a
      href="{{ route('home') }}"
      class="logo-link"
      aria-label="{{ t('messages.header.back_to_home') }}"
    >
      <div class="logo">
        <h1>
          ACD
        </h1>
      </div>
    </a>

    <button
      type="button"
      class="menu-toggle"
      id="menuToggle"
      aria-label="{{ t('messages.header.toggle_menu') }}"
      aria-expanded="false"
      aria-controls="headerContent"
    >
      <span class="material-symbols-outlined icon-open">menu</span>
      <span class="material-symbols-outlined icon-close">close</span>
    </button>
  </div>

  <div class="header-content" id="headerContent">
    <nav id="primaryNav">
      <a href="{{ route('home') }}">
        <div class="menu-item {{ request.url() === '/' ? 'active' : '' }}">
          <span class="material-symbols-outlined">map</span>
          <p>
            {{ t('messages.header.explore') }}
          </p>
        </div>
      </a>

      <a href="{{ route('sites') }}">
        <div class="menu-item {{ request.url() === '/sites' ? 'active' : '' }}">
          <span class="material-symbols-outlined">list</span>
          <p>
            {{ t('messages.header.list') }}
          </p>
        </div>
      </a>

      <a href="{{ route('profile.show') }}">
        <div
          class="menu-item {{ request.url() === '/profile' || request.url() === '/login' || request.url() === '/register' ? 'active' : '' }}"
        >
          <span class="material-symbols-outlined">account_circle</span>
          <p>
            {{ t('messages.header.profile') }}
          </p>
        </div>
      </a>

      <a href="{{ route('bookmarks') }}">
        <div class="menu-item {{ request.url() === '/bookmarks' ? 'active' : '' }}">
          <span class="material-symbols-outlined">list_alt_check</span>
          <p>
            {{ t('messages.header.bookmarked_sites') }}
          </p>
        </div>
      </a>

      <a href="{{ route('visits') }}">
        <div class="menu-item {{ request.url() === '/visits' ? 'active' : '' }}">
          <span class="material-symbols-outlined">patient_list</span>
          <p>
            {{ t('messages.header.visited_sites') }}
          </p>
        </div>
      </a>
    </nav>

    <div class="lang-container">
      <div class="lang-popup" id="langPopup">
        <a
          href="{{ route('lang.switch', { locale: 'en' }) }}"
          style="text-decoration: none; color: inherit;"
        >
          <div class="lang-option">
            <img src="https://flagcdn.com/w80/us.png" class="flag-icon" />
            <span class="lang-text">EN</span>
          </div>
        </a>
        <a
          href="{{ route('lang.switch', { locale: 'fr' }) }}"
          style="text-decoration: none; color: inherit;"
        >
          <div class="lang-option">
            <img src="https://flagcdn.com/w80/fr.png" class="flag-icon" />
            <span class="lang-text">FR</span>
          </div>
        </a>
      </div>
      <div class="language-picker" id="langTrigger">
        @if(i18n.locale === 'en')
          <img src="https://flagcdn.com/w80/us.png" id="mainFlag" class="flag-icon" />
          <span class="lang-text" id="mainText">EN</span>
        @else
          <img src="https://flagcdn.com/w80/fr.png" id="mainFlag" class="flag-icon" />
          <span class="lang-text" id="mainText">FR</span>
        @end
        <span class="material-symbols-outlined" style="font-size: 20px; color: white;">expand_less</span>
      </div>
    </div>
    <button id="theme-toggle" aria-label="Toggle Theme">
      <svg
        id="sun-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="5" />

        <line x1="12" y1="1" x2="12" y2="3" />

        <line x1="12" y1="21" x2="12" y2="23" />

        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />

        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />

        <line x1="1" y1="12" x2="3" y2="12" />

        <line x1="21" y1="12" x2="23" y2="12" />

        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />

        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />

      </svg>

      <svg
        id="moon-icon"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />

      </svg>
    </button>
  </div>
</header>

<script>
  const mainHeader = document.getElementById("mainHeader");

  const menuToggle = document.getElementById("menuToggle");

  const headerContent = document.getElementById("headerContent");

  const trigger = document.getElementById("langTrigger");

  const popup = document.getElementById("langPopup");

  const mainFlag = document.getElementById("mainFlag");

  const mainText = document.getElementById("mainText");

  const mobileMedia = window.matchMedia("(max-width: 900px)");

  function closeMobileMenu() {
    if (!mainHeader || !menuToggle) return;
    mainHeader.classList.remove("is-open");
    menuToggle.classList.remove("is-open");
    menuToggle.setAttribute("aria-expanded", "false");
  }

  if (menuToggle && mainHeader && headerContent) {
    menuToggle.addEventListener("click", e => {
      e.stopPropagation();
      const isOpen = mainHeader.classList.toggle("is-open");
      menuToggle.classList.toggle("is-open", isOpen);
      menuToggle.setAttribute("aria-expanded", String(isOpen));
    });
    headerContent.querySelectorAll("a").forEach(link => {
      link.addEventListener("click", closeMobileMenu);
    });
  }

  trigger.addEventListener("click", e => {
    e.stopPropagation();
    popup.classList.toggle("show");
  });

  window.addEventListener("resize", () => {
    if (!mobileMedia.matches) {
      closeMobileMenu();
    }
  });

  window.addEventListener("click", e => {
    popup.classList.remove("show");
    if (mainHeader && mainHeader.classList.contains("is-open") && !mainHeader.contains(e.target)) {
      closeMobileMenu();
    }
  });
</script>
