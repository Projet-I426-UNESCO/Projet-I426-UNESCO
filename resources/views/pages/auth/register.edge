    border-radius: 7px;
    display: flex;
    flex-direction: column;
    gap: 25px;
    width: 100%;
    max-width: 400px;
  }

  h1 {
    margin: 0;
    font-size: 1.5rem;
    color: white;
    margin-bottom: 10px;
  }

  form {
    display: flex;
    flex-direction: column;
