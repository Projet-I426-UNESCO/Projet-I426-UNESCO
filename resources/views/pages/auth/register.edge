<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@23,400,0,0&icon_names=arrow_back"
/>

@layout({
  title: t('messages.auth.register_title'),
  hideHeader: true
})

  <div class="goback">
    <a href="{{ route('home') }}" class="link">
      <div class="goback-link">
        <span class="material-symbols-outlined">arrow_back</span>
        <p>
          {{ t('messages.auth.back') }}
        </p>
      </div>
    </a>
  </div>

  <div class="auth-page-container">
    <div class="auth-card">
      <h1>
        {{ t('messages.auth.register_title') }}
      </h1>

      <form method="POST" action="{{ route('auth.register.store') }}">
        {{ csrfField() }}
        <div class="input-group">
          <input
            type="text"
            name="fullName"
            value="{{ old('fullName') || '' }}"
            placeholder="{{ t('messages.auth.username_placeholder') }}"
            required
          />
          @inputError('fullName')
            <span class="error-text">{{ $messages.join(', ') }}</span>
          @end
        </div>

        <div class="input-group">
          <input
            type="email"
            name="email"
            value="{{ old('email') || '' }}"
            placeholder="{{ t('messages.auth.email_placeholder') }}"
            required
          />
          @inputError('email')
            <span class="error-text">{{ $messages.join(', ') }}</span>
          @end
        </div>

        <div class="input-group">
          <div class="password-wrapper">
            <input
              type="password"
              name="password"
              placeholder="{{ t('messages.auth.password_placeholder') }}"
              required
            />
          </div>
          @inputError('password')
            <span class="error-text">{{ $messages.join(', ') }}</span>
          @end
        </div>

        <button type="submit" class="btn-primary">
          {{ t('messages.auth.register_button') }}
      </button>
      </form>

      <div class="auth-footer">
        <span>{{ t('messages.auth.has_account') }}</span>
        <a href="{{ route('auth.login.show') }}" class="link">
          {{ t('messages.auth.login_button') }}
      </a>
      </div>
    </div>
  </div>

@end
