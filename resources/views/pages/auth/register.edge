  }

  input {
    padding: 12px;
    border: 1px solid #3b3b3b;
    border-radius: 8px;
    font-size: 16px;
    width: 100%;
    background-color: #3A4151;
    color: #ebebeb;
  }

  input::placeholder {
    color: #c2c2c2;
    opacity: 1;
  }

  .btn-primary {
    background: #6366f1;
    color: white;
    border: none;
    padding: 12px;
