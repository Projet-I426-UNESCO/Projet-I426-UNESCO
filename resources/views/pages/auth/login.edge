hideHeader: true
})
<div class="goback">
  <a href="{{ route('home') }}" class="link">
    <div class="goback-link">
      <span class="material-symbols-outlined" height="20" width="20">
        arrow_back
      </span>
      <p>
        Retour en arrière</p>
    </div>
  </a>
</div>
<div class="auth-page-container">
  <div class="auth-card">
    <h1>Connexion</h1>

    <form method="POST" action="{{ route('auth.login.store') }}">
      {{ csrfField() }}

      <div class="input-group">
        <input type="text" name="fullName" value="{{ old('fullName') || '' }}"
          placeholder="Nom d'utilisateur (ex. xXx67Erdem67xXx-LFT)" required />
        @inputError('fullName')
        <span class="error-text">{{ $messages.join(', ') }}</span>
        @end
      </div>

      <div class="input-group">
        <div class="password-wrapper">
          <input type="password" name="password" placeholder="Mot de passe" required />
        </div>
        @inputError('password')
        <span class="error-text">{{ $messages.join(', ') }}</span>
        @end
      </div>


      <button type="submit" class="btn-primary">Se connecter</button>

      @error('E_INVALID_CREDENTIALS')
      <p class="error-message">Identifiants invalides.</p>
      @end
    </form>

    <div class="auth-footer">
      <p>Pas de compte ?</p>
      <a class="register-link" href="/register">S'inscrire</a>
    </div>
  </div>
</div>
@end

