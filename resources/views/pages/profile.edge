<!doctype html>
<html lang="{{ i18n.locale }}">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>
    {{ t('messages.profile.title') }} -
  </title>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200"
  />
  <style>
    @import url("https://fonts.googleapis.com/css2?family=K2D:wght@300;400;500&display=swap");

    main {
      padding: 25px;
    }

    .info-block {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-gap: 10px;
      grid-auto-rows: minmax(150px, auto);
      max-width: 1500px;
      margin: 0 auto;
      align-items: stretch;
    }

    .info-block > div {
      background-color: #1e2533;
      border-radius: 20px;
      padding: 20px;
      color: #d1d5db;
    }

    .info-block > div:last-child {
      background-color: #0f172a;
      padding: 0;
    }

    .name-block {
      display: flex;
      align-items: center;
      grid-column: 1 / 3;
      justify-content: space-between;
      background: linear-gradient(90deg, rgba(30, 41, 59, 1) 0%, rgba(15, 23, 42, 1) 100%);
      border: 1px solid #2D313E;
    }

    .name-avatar {
      display: flex;
      align-items: center;
      gap: 20px;
    }

    .avatar {
      height: 100px;
      width: 100px;
      border: 4px solid #2D313E;
      border-radius: 50%;
      object-fit: cover;
    }

    .name h2 {
      color: #ffffff;
      font-size: 28px;
      margin: 0;
    }

    .name p {
      color: #94a3b8;
      font-size: 14px;
      margin: 0;
    }

    .last-visit-block {
      grid-column: 3;
      grid-row: 1/4;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .last-visit-block img {
      width: 100%;
      height: 250px;
      object-fit: cover;
      border-radius: 12px;
      margin-bottom: 10px;
    }

    .progress-block {
      grid-column: 1/2;
      grid-row: 2;
    }

    .progress-value {
      font-size: 32px;
      font-weight: bold;
      color: #ffffff;
      margin-top: 10px;
    }

    .progress-bar {
      background-color: #2d3748;
      border-radius: 8px;
      height: 12px;
      margin-top: 10px;
      overflow: hidden;
    }

    .progress-fill {
      background: linear-gradient(90deg, #5f7ef2 0%, #68bff8 100%);
      height: 100%;
    }

    .continent-stats-block {
      grid-column: 2;
      grid-row: 2/4;
    }

    .boss {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px 8px;
      margin-top: 12px;
    }

    .continent-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .continent-donut {
      position: relative;
      width: 80px;
      height: 80px;
    }

    .continent-donut svg {
      width: 80px;
      height: 80px;
      transform: rotate(-90deg);
    }

    .continent-donut .track {
      fill: none;
      stroke: #2d3748;
      stroke-width: 7;
    }

    .continent-donut .arc {
      fill: none;
      stroke-width: 7;
      stroke-linecap: round;
      transition: stroke-dashoffset 0.6s ease;
    }

    .continent-donut .arc.color-1 { stroke: #5f7ef2; }
    .continent-donut .arc.color-2 { stroke: #f59e0b; }
    .continent-donut .arc.color-3 { stroke: #10b981; }
    .continent-donut .arc.color-4 { stroke: #ec4899; }
    .continent-donut .arc.color-5 { stroke: #8b5cf6; }
    .continent-donut .arc.color-6 { stroke: #06b6d4; }

    .continent-donut-label {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      font-weight: bold;
      color: #ffffff;
    }

    .continent-name {
      font-size: 11px;
      color: #94a3b8;
      text-align: center;
      line-height: 1.3;
    }

    .few-last-visits-block {
      grid-column: 1;
      grid-row: 3/5;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .recent-visits-title {
      font-size: 22px;
      font-weight: 700;
      color: #ffffff;
      margin: 0 0 16px 0;
    }

    .visit-item {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.07);
      height: 80px;
      max-height: 100px;
      overflow: hidden;
      box-sizing: border-box;
    }

    .visit-item:last-child {
      border-bottom: none;
    }

    .visit-item-left {
      display: flex;
      flex-direction: column;
      gap: 3px;
    }

    .visit-item-name {
      font-size: 16px;
      font-weight: 600;
      color: #ffffff;
      text-decoration: none;
    }

    .visit-item-name:hover {
      color: #737df3;
    }

    .visit-item-country {
      font-size: 13px;
      color: #64748b;
    }

    .visit-item-date {
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      white-space: nowrap;
      padding-left: 12px;
    }

    .no-visits-msg {
      color: #64748b;
      font-size: 14px;
      margin-top: 8px;
    }

    .general-stats-block {
      grid-column: 2/4;
      grid-row: 4;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;
    }

    .stat-card {
      background-color: #1e2533;
      border-radius: 12px;
      padding: 15px;
      text-align: center;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 6px;
    }

    .stat-label {
      display: block;
      font-size: 12px;
      color: #94a3b8;
    }

    .stat-value {
      font-size: 24px;
      font-weight: bold;
      color: #ffffff;
    }

    .line {
      display: flex;
      gap: 10px;
    }

    .logout-btn,
    .modif-btn {
      height: 35px;
      width: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 8px;
      color: white;
      text-decoration: none;
      font-weight: 500;
    }

    .logout-btn {
      background-color: #F25F61;
    }

    .modif-btn {
      background-color: #5F7EF2;
    }

    .map-list-block {
      height: 500px;
      background-color: #1e2533;
      max-width: 1500px;
      margin: 0 auto;
      padding-top: 50px;
      border-radius: 20px;
      margin-top: 10px;
    }
  </style>
</head>

<body>
  @layout('components/layout/index', { title: 'Accueil' })

    <main>
      <div class="info-block">
        <div class="name-block">
          <div class="name-avatar">
            <img class="avatar" src="" alt="Avatar" />
            <div class="name">
              <h2>{{ auth.user.fullName }}</h2>
            </div>
          </div>
          <div class="line">
            <form method="POST" action="{{ route('auth.logout') }}">
              {{ csrfField() }}
              <button type="submit" class="logout-btn">
                {{ t('messages.profile.logout') }}
              </button>
            </form>
            <a href="" class="modif-btn">
              {{ t('messages.profile.edit_account') }}
            </a>
          </div>
        </div>

        <div class="last-visit-block">
          <div>
            <p style="color: #ffffff; font-weight: 500; margin-bottom: 10px;">
              {{ t('messages.profile.last_visit') }}
            </p>
            @if(stats.lastVisit)
              <img src="{{ stats.lastVisit.localImageMain || stats.lastVisit.mainImageUrl }}" 
                   alt="{{ stats.lastVisit.nameFr }}" />
              <h3 style="margin: 0; color: #ffffff; font-size: 14px;">
                {{ stats.lastVisit.nameFr }}
              </h3>
              <p style="margin: 5px 0 0 0; color: #94a3b8; font-size: 12px;">
                @if(stats.lastVisit.statesNames && stats.lastVisit.statesNames.length > 0)
                  {{ stats.lastVisit.statesNames[0] }}
                @end
              </p>
            @else
              <p style="color: #94a3b8;">
                {{ t('messages.profile.no_visit_yet') }}
              </p>
            @end
          </div>
        </div>

        <div class="progress-block">
          <p style="margin-top: 0;">{{ t('messages.profile.global_progress') }}</p>
          <div class="progress-value">{{ stats.visitedSites }} / {{ stats.totalSites }}</div>
          <div class="progress-bar">
            <div class="progress-fill" style="width: {{ stats.completionPercentage }}%;"></div>
          </div>
          <p style="margin-bottom: 0; margin-top: 8px; font-size: 12px; color: #94a3b8;">
            {{ stats.completionPercentage }}%
          </p>
        </div>

        <div class="continent-stats-block">
          <p style="margin-top: 0;">{{ t('messages.profile.continent_exploration') }}</p>
          <div class="boss">
            @each(data in stats.regionStats)
              <div class="continent-item">
                <div class="continent-donut">
                  {{-- circumference = 2 * π * r = 2 * 3.14159 * 31 ≈ 194.78 --}}
                  <svg viewBox="0 0 80 80">
                    <circle class="track" cx="40" cy="40" r="31" />
                    <circle
                      class="arc color-{{ data.colorIndex }}"
                      cx="40" cy="40" r="31"
                      stroke-dasharray="194.78"
                      stroke-dashoffset="{{ 194.78 - (194.78 * data.percentage / 100) }}"
                    />
                  </svg>
                  <div class="continent-donut-label">{{ data.percentage }}%</div>
                </div>
                <div class="continent-name">{{ data.region }}</div>
              </div>
            @endeach
          </div>
        </div>

        <div class="few-last-visits-block">
          <h2 class="recent-visits-title">{{ t('messages.profile.recent_visits') }}</h2>
          @if(stats.recentVisits.length > 0)
            @each(visit in stats.recentVisits)
              <div class="visit-item">
                <div class="visit-item-left">
                  <a href="/site/{{ visit.id }}" class="visit-item-name">{{ visit.name }}</a>
                  <span class="visit-item-country">{{ visit.country }}</span>
                </div>
                <span class="visit-item-date">{{ visit.date }}</span>
              </div>
            @endeach
          @else
            <p class="no-visits-msg">{{ t('messages.profile.no_visit_yet') }}</p>
          @end
        </div>

        <div class="general-stats-block">
          <div class="stat-card">
            <span class="stat-label">{{ t('messages.profile.visited_sites') }}</span>
            <span class="stat-value">{{ stats.visitedSites }}/{{ stats.totalSites }}</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">{{ t('messages.profile.completion_rate') }}</span>
            <span class="stat-value">{{ stats.completionPercentage }}%</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">{{ t('messages.profile.most_visited_region') }}</span>
            <span class="stat-value">{{ stats.mostVisitedRegion || 'N/A' }}</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">{{ t('messages.profile.most_visited_country') }}</span>
            <span class="stat-value">{{ stats.mostVisitedCountry || 'N/A' }}</span>
          </div>
        </div>
      </div>

      <div class="map-list-block">
        
      </div>
    </main>

  @end
</body>
</html>