<body>
  @layout('components/layout/index', { title: 'Accueil' })

  <main>
    <div class="info-block">
      <div class="name-block">
        <div class="name-avatar">
          <img class="avatar" src="{{ auth.user.avatar || '' }}" alt="Avatar" />
          <div class="name">
            <h2>
              {{ auth.user.fullName }}
            </h2>
          </div>
        </div>
        <div class="line">
          <form method="POST" action="{{ route('auth.logout') }}">
            {{ csrfField() }}
            <button type="submit" class="profile-btn logout-btn">
              {{ t('messages.profile.logout') }}
            </button>
          </form>

          <button class="profile-btn modif-btn" onclick="document.getElementById('editModal').classList.add('show')">
            {{ t('messages.profile.edit_account') }}
          </button>
        </div>
      </div>

      <div class="last-visit-block">
        <div>
          <p style="color: #ffffff; font-weight: 500; margin-bottom: 10px;">
            {{ t('messages.profile.last_visit') }}
          </p>
          @if(stats.lastVisit)
          <img src="{{ stats.lastVisit.localImageMain || stats.lastVisit.mainImageUrl }}"
            alt="{{ stats.lastVisit.nameFr }}" />
          <h3 style="margin: 0; color: #ffffff; font-size: 14px;">
            {{ stats.lastVisit.nameFr }}
          </h3>
          <p style="margin: 5px 0 0 0; color: #94a3b8; font-size: 12px;">
            @if(stats.lastVisit.statesNames && stats.lastVisit.statesNames.length > 0)
            {{ stats.lastVisit.statesNames[0] }}
            @end
          </p>
          @else
          <p style="color: #94a3b8;">
            {{ t('messages.profile.no_visit_yet') }}
          </p>
          @end
        </div>
      </div>

      <div class="progress-block">
        <p style="margin-top: 0;">
          {{ t('messages.profile.global_progress') }}
        </p>
        <div class="progress-value">
          {{ stats.visitedSites }} / {{ stats.totalSites }}
        </div>
        <div class="progress-bar">
          <div class="progress-fill" style="width: {{ stats.completionPercentage }}%;">
          </div>
        </div>
        <p style="margin-bottom: 0; margin-top: 8px; font-size: 12px; color: #94a3b8;">
          {{ stats.completionPercentage }}%
        </p>
      </div>

      <div class="continent-stats-block">
        <p style="margin-top: 0;">
          {{ t('messages.profile.continent_exploration') }}
        </p>
        <div class="boss">
          @each(data in stats.regionStats)
          <div class="continent-item">
            <div class="continent-donut">
              <svg viewBox="0 0 80 80">
                <circle class="track" cx="40" cy="40" r="31" />
                <circle class="arc color-{{ data.colorIndex }}" cx="40" cy="40" r="31" stroke-dasharray="194.78"
                  stroke-dashoffset="{{ 194.78 - (194.78 * data.percentage / 100) }}" />
              </svg>
              <div class="continent-donut-label">
                {{ data.percentage }}%
              </div>
            </div>
            <div class="continent-name">
              {{ data.region }}
            </div>
          </div>
          @endeach
        </div>
      </div>

      <div class="few-last-visits-block">
        <h2 class="recent-visits-title">
          {{ t('messages.profile.recent_visits') }}
        </h2>
        @if(stats.recentVisits.length > 0)
        @each(visit in stats.recentVisits)
        <div class="visit-item">
          <div class="visit-item-left">
            <a href="/site/{{ visit.id }}" class="visit-item-name">{{ visit.name }}</a>
            <span class="visit-item-country">{{ visit.country }}</span>
          </div>
          <span class="visit-item-date">{{ visit.date }}</span>
        </div>
        @endeach
        @else
        <p class="no-visits-msg">
          {{ t('messages.profile.no_visit_yet') }}
        </p>
        @end
      </div>

      <div class="general-stats-block">
        <div class="stat-card">
          <span class="stat-label">{{ t('messages.profile.visited_sites') }}</span>
          <span class="stat-value">{{ stats.visitedSites }}/{{ stats.totalSites }}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">{{ t('messages.profile.completion_rate') }}</span>
          <span class="stat-value">{{ stats.completionPercentage }}%</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">{{ t('messages.profile.most_visited_region') }}</span>
          <span class="stat-value">{{ stats.mostVisitedRegion || 'N/A' }}</span>
        </div>
        <div class="stat-card">
          <span class="stat-label">{{ t('messages.profile.most_visited_country') }}</span>
          <span class="stat-value">{{ stats.mostVisitedCountry || 'N/A' }}</span>
        </div>
      </div>
    </div>

    <!-- Map Section -->
    <div class="profile-map-section">
      <div class="map-header">
        <h2 class="map-title" id="mapTitle">
          Carte des sites visités
        </h2>
        <div class="map-controls">
          <div class="map-toggle-group">
            <button class="map-toggle-btn active" id="btnMapVisited" onclick="setMapFilter('visited')">Sites
              visités</button>
            <button class="map-toggle-btn" id="btnMapMarked" onclick="setMapFilter('marked')">Sites marqués</button>
          </div>
          <a href="{{ route('visits') }}" target="_blank" class="open-tab-btn" id="openTabBtn">
            Ouvrir dans un nouveau onglet
            <span class="material-symbols-outlined">open_in_new</span>
          </a>
        </div>
      </div>
      <div class="map-box-container">
        <div id="profile-map">
        </div>
      </div>
    </div>

    <div class="profile-list-section">
      <h2 class="list-title" id="listTitle">
        Liste complète des sites visités
      </h2>
      <div class="list-card">
        <div class="list-card-header">
          <div class="list-header-left">
            Continent / Site
          </div>
          <div class="list-header-right">
            Ajouté dans la liste
          </div>
        </div>

        <div id="accordion-list-container">
        </div>
      </div>
    </div>

    <div id="editModal" class="edit-modal-overlay" onclick="handleOverlayClick(event)">
      <div class="edit-modal">
        <div class="edit-modal-header">
          <h3>
            Modifier le profil
          </h3>
          <button class="edit-modal-close"
            onclick="document.getElementById('editModal').classList.remove('show')">&times;</button>
        </div>

        @if(flashMessages.has('editError'))
        <div class="edit-alert edit-alert-error">
          {{ flashMessages.get('editError') }}
        </div>
        @end
        @if(flashMessages.has('editSuccess'))
        <div class="edit-alert edit-alert-success">
          {{ flashMessages.get('editSuccess') }}
        </div>
        @end

        <form method="POST" action="{{ route('profile.update') }}" enctype="multipart/form-data" class="edit-form">
          {{ csrfField() }}
          <div class="edit-avatar-preview">
            <img id="avatarPreview" src="{{ auth.user.avatar || '' }}" alt="Photo de profil"
              onerror="this.style.display='none'" />
            <span id="avatarPlaceholder" class="avatar-placeholder material-symbols-outlined"
              style="{{ auth.user.avatar ? 'display:none' : '' }}">person</span>
          </div>

          <label class="edit-field-label" for="avatarInput">Photo de profil</label>
          <label class="edit-upload-btn" for="avatarInput">
            <span class="material-symbols-outlined">upload</span>
            Choisir une image
          </label>
          <input type="file" id="avatarInput" name="avatar" accept="image/*" style="display:none"
            onchange="previewAvatar(event)" />
          <span id="avatarFileName" class="edit-file-name"></span>

          <label class="edit-field-label" for="nicknameInput">Pseudo</label>
          <input class="edit-input" type="text" id="nicknameInput" name="nickname"
            placeholder="{{ auth.user.fullName }}" value="{{ auth.user.fullName }}" />

          <button type="submit" class="edit-submit-btn">Enregistrer</button>
        </form>
      </div>
    </div>
  </main>

  <script>
    const ui = {
      accordionList: "accordion-list-container",
      btnMapVisited: "btnMapVisited",
      btnMapMarked: "btnMapMarked",
      openTabBtn: "openTabBtn",
      mapTitle: "mapTitle",
      listTitle: "listTitle"
    };

    const labels = {
      mapVisited: "Carte des sites visités",
      mapMarked: "Carte des sites marqués",
      listVisited: "Liste complète des sites visités",
      listMarked: "Liste complète des sites marqués",
      noMarked: "Aucun site marqué pour l'instant",
      noVisits: "{{ t('messages.profile.no_visit_yet') }}"
    };

    const routes = {
      visits: "{{ route('visits') }}",
      bookmarks: "{{ route('bookmarks') }}"
    };

    const mapConfig = {
      accessToken: "{{ mapboxToken }}",
      container: "profile-map",
      style: "mapbox://styles/mapbox/standard",
      projection: "mercator",
      zoom: 1.5,
      center: [10, 20]
    };

    const markerColors = {
      visited: "#fe8d50",
      marked: "#8bf7df"
    };

    function previewAvatar(event) {
      const file = event.target.files[0];
      if (!file) return;
      document.getElementById("avatarFileName").textContent = file.name;
      const reader = new FileReader();
      reader.onload = e => {
        const img = document.getElementById("avatarPreview");
        const placeholder = document.getElementById("avatarPlaceholder");
        img.src = e.target.result;
        img.style.display = "block";
        if (placeholder) placeholder.style.display = "none";
      };
      reader.readAsDataURL(file);
    }

    function handleOverlayClick(e) {
      if (e.target === document.getElementById("editModal")) {
        document.getElementById("editModal").classList.remove("show");
      }
    }
    // --- MAPBOX & ACCORDION SCRIPTS ---

    const markersData = {{{ JSON.stringify(mapMarkers) }}};

    const visitedByRegion = {{{ JSON.stringify(visitedByRegion) }}};

    const markedByRegion = {{{ JSON.stringify(markedByRegion) }}};

    let currentMapFilter = "visited";

    let activeMarkerInstances = [];

    mapboxgl.accessToken = mapConfig.accessToken;

    const profileMap = new mapboxgl.Map({
      container: mapConfig.container,
      style: mapConfig.style,
      projection: mapConfig.projection,
      zoom: mapConfig.zoom,
      center: mapConfig.center
    });

    profileMap.addControl(new mapboxgl.NavigationControl());

    function renderProfileMapMarkers() {
      // Clear previous markers
      activeMarkerInstances.forEach(marker => marker.remove());
      activeMarkerInstances = [];
      markersData.forEach(data => {
        if (currentMapFilter === "visited" && !data.isVisited) return;
        if (currentMapFilter === "marked" && !data.isMarked) return;
        const color = currentMapFilter === "visited" ? markerColors.visited : markerColors.marked;
        const popup = new mapboxgl.Popup({
          offset: 25
        }).setHTML(`<div style="color: #1e293b; padding: 4px;"><h4 style="margin: 0 0 4px 0; font-size: 14px; font-weight: 600;">${data.name}</h4><a href="/site/${data.id}" style="color: #3b82f6; font-size: 12px; font-weight: 600; text-decoration: none;">Voir le site</a></div>`);
        const marker = new mapboxgl.Marker({
          color: color
        }).setLngLat([data.lon, data.lat]).setPopup(popup).addTo(profileMap);
        activeMarkerInstances.push(marker);
      });
    }

    profileMap.on("load", () => {
      renderProfileMapMarkers();
    });

    function renderDynamicAccordionList(mode) {
      const container = document.getElementById(ui.accordionList);
      if (!container) return;
      const data = mode === "visited" ? visitedByRegion : markedByRegion;
      if (!data || data.length === 0) {
        const noMsg = mode === "visited" ? labels.noVisits : labels.noMarked;
        container.innerHTML = `<p class="no-visits-msg" style="text-align: center; padding: 20px 0;">${noMsg}</p>`;
        return;
      }
      let html = "";
      data.forEach((item, index) => {
        let sitesHtml = "";
        item.sites.forEach(site => {
          let dotClass = "mixed";
          let dotTitle = "Mixte";
          if (site.category === "cultural" || site.category === "Culturel") {
            dotClass = "cultural";
            dotTitle = "Culturel";
          } else if (site.category === "natural" || site.category === "Naturel") {
            dotClass = "natural";
            dotTitle = "Naturel";
          }
          sitesHtml += `
                    <div class="site-row">
                      <div class="site-row-left">
                        <div class="category-dot ${dotClass}" title="${dotTitle}"></div>
                        <a href="/site/${site.id}" class="site-row-name">${site.name}</a>
                      </div>
                      <div class="site-row-right">
                        ${site.addedAt}
                      </div>
                    </div>
                  `;
        });
        html += `
                  <div class="continent-accordion" id="accordion-${index}">
                    <div class="continent-accordion-trigger" onclick="toggleAccordion('${index}')">
                      <span class="material-symbols-outlined chevron">expand_more</span>
                      <span>${item.regionName}</span>
                    </div>
                    <div class="continent-accordion-content">
                      ${sitesHtml}
                    </div>
                  </div>
                `;
      });
      container.innerHTML = html;
      // Force recalculate scrollHeight for transition after DOM update
      setTimeout(() => {
        const accordions = container.querySelectorAll(".continent-accordion");
        accordions.forEach(acc => {
          const content = acc.querySelector(".continent-accordion-content");
          if (content && !acc.classList.contains("collapsed")) {
            content.style.maxHeight = content.scrollHeight + "px";
          }
        });
      }, 50);
    }

    function setMapFilter(mode) {
      currentMapFilter = mode;
      // Update button classes
      const btnVisited = document.getElementById(ui.btnMapVisited);
      const btnMarked = document.getElementById(ui.btnMapMarked);
      if (mode === "visited") {
        btnVisited.classList.add("active");
        btnMarked.classList.remove("active");
      } else {
        btnVisited.classList.remove("active");
        btnMarked.classList.add("active");
      }
      renderProfileMapMarkers();
      // Dynamic external link
      const openTabBtn = document.getElementById(ui.openTabBtn);
      if (openTabBtn) {
        if (mode === "visited") {
          openTabBtn.href = routes.visits;
        } else {
          openTabBtn.href = routes.bookmarks;
        }
      }
      // Update headers
      const mapTitle = document.getElementById(ui.mapTitle);
      const listTitle = document.getElementById(ui.listTitle);
      if (mapTitle) {
        mapTitle.textContent = mode === "visited" ? labels.mapVisited : labels.mapMarked;
      }
      if (listTitle) {
        listTitle.textContent = mode === "visited" ? labels.listVisited : labels.listMarked;
      }
      // Dynamic List Rendering
      renderDynamicAccordionList(mode);
    }
    // Collapsible Accordion logic

    function toggleAccordion(index) {
      const accordion = document.getElementById(`accordion-${index}`);
      if (!accordion) return;
      const content = accordion.querySelector(".continent-accordion-content");
      if (!content) return;
      const isCollapsed = accordion.classList.contains("collapsed");
      if (isCollapsed) {
        accordion.classList.remove("collapsed");
        content.style.maxHeight = content.scrollHeight + "px";
      } else {
        accordion.classList.add("collapsed");
        content.style.maxHeight = "0px";
      }
    }
    // Set scroll height dynamically on DOM load so smooth expand/collapse transition works

    window.addEventListener("DOMContentLoaded", () => {
      renderDynamicAccordionList("visited");
    });
  </script>

  @end
</body>

</html>
<style>
  main {
    padding: 25px;
  }
</style>