@layout('components/layout/index', { title: 'Sites', page: 'sites' })

<main class="sites-main">
  <div class="controls">
    <div class="search-container">
      <div class="search-pill" style="flex: 1; min-width: 200px;">
        <span class="material-symbols-outlined">search</span>
        <input id="siteSearchInput" type="text" placeholder="{{ t('messages.sites.search_placeholder') }}"
          autocomplete="off" />
      </div>
      <div class="search-pill">
        <button class="filter" onclick="openFilters()">
          <span class="material-symbols-outlined">filter_list</span>
        </button>
        <p>
          @if(filter)
          {{ t('messages.sites.filter_active') }} {{ filter }}
          @else
          {{ t('messages.sites.filter_none') }}
          @end
        </p>
      </div>
    </div>
  </div>

  <div class="sites-grid">
    @each((unesco) in unescos)
    <a href="{{ route('site.show', { id: unesco.id }) }}" class="site-box">
      @if(unesco.localImageThumb)
      <img src="{{ unesco.localImageThumb }}" class="site-box-img" />
      @else
      <img src="../../../public/placeholders/placeholderImage.png" class="site-box-img" />
      @end

      <div class="site-box-info">
        <h3>{{ unesco.nameFr }}</h3>
        <p>{{ unesco.statesNames }}</p>
      </div>

      @if(unesco.added)
      <button class="delete-btn">
        <span class="material-symbols-outlined">delete</span>
        {{ t('messages.sites.remove_from_list') }}
      </button>
      @else
      <button class="btn-primary">
        <span class="material-symbols-outlined">add</span>
        {{ t('messages.sites.add_to_list') }}
      </button>
      @end

      @if(unesco.visited)
      <button class="visited-btn">
        <span class="material-symbols-outlined">check</span>
        {{ t('messages.sites.site_visited') }}
      </button>
      @else
      <button class="action-btn btn-visit">
        <span class="material-symbols-outlined">check</span>
        {{ t('messages.sites.mark_as_visited') }}
      </button>
      @end
    </a>
    @end
  </div>

  <!-- Filter Popup -->
  <div id="filterPopup" class="filter-popup">
    <div class="filter-popup-content">
      <div class="filter-popup-header">
        <h2>{{ t('messages.sites.filters_title') }}</h2>
        <button class="filter-close-btn" onclick="closeFilters()">
          <span class="material-symbols-outlined">close</span>
        </button>
      </div>
      <div class="filter-popup-body">
        <div class="filter-section">
          <label>{{ t('messages.sites.filter_country_label') }}</label>
          <input type="text" id="countryFilter" placeholder="{{ t('messages.sites.filter_country_placeholder') }}" />
        </div>
        <div class="filter-section">
          <label>{{ t('messages.sites.filter_type_label') }}</label>
          <select id="typeFilter">
            <option value="">{{ t('messages.sites.filter_type_all') }}</option>
            <option value="cultural">{{ t('messages.sites.filter_type_cultural') }}</option>
            <option value="natural">{{ t('messages.sites.filter_type_natural') }}</option>
            <option value="mixed">{{ t('messages.sites.filter_type_mixed') }}</option>
          </select>
        </div>
      </div>
      <div class="filter-popup-footer">
        <button class="btn-primary" onclick="applyFilters()">{{ t('messages.sites.apply_filters') }}</button>
        <button class="btn-secondary" onclick="resetFilters()">{{ t('messages.sites.reset_filters') }}</button>
      </div>
    </div>
  </div>
</main>

<script>
  const searchInput = document.getElementById("siteSearchInput");
  const countryFilterInput = document.getElementById("countryFilter");
  const typeFilterInput = document.getElementById("typeFilter");

  function normalizeSearchValue(value) {
    return (value || "")
      .toString()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  function filterSites() {
    const searchQuery = normalizeSearchValue(searchInput?.value);
    const countryQuery = normalizeSearchValue(countryFilterInput?.value);
    const typeQuery = normalizeSearchValue(typeFilterInput?.value);

    const sites = document.querySelectorAll(".site-box");
    sites.forEach((site) => {
      const siteName = normalizeSearchValue(site.querySelector(".site-box-info h3")?.textContent);
      const countryName = normalizeSearchValue(site.querySelector(".site-box-info p")?.textContent);
      const siteText = `${siteName} ${countryName}`;
      const siteType = normalizeSearchValue(site.dataset.type);

      const matchesSearch = !searchQuery || siteText.includes(searchQuery);
      const matchesCountry = !countryQuery || countryName.includes(countryQuery);
      const matchesType = !typeQuery || !siteType || siteType === typeQuery;

      site.style.display = matchesSearch && matchesCountry && matchesType ? "flex" : "none";
    });
  }

  function openFilters() {
    const popup = document.getElementById("filterPopup");
    popup.classList.add("show");
  }

  function closeFilters() {
    const popup = document.getElementById("filterPopup");
    popup.classList.remove("show");
  }

  function applyFilters() {
    filterSites();
    closeFilters();
  }

  function resetFilters() {
    countryFilterInput.value = "";
    typeFilterInput.value = "";

    filterSites();

    closeFilters();
  }

  if (searchInput) {
    searchInput.addEventListener("input", filterSites);
  }

  if (countryFilterInput) {
    countryFilterInput.addEventListener("input", filterSites);
  }

  if (typeFilterInput) {
    typeFilterInput.addEventListener("change", filterSites);
  }

  document.getElementById("filterPopup").addEventListener("click", function (e) {
    if (e.target === this) {
      closeFilters();
    }
  });
</script>

@end