@layout('components/layout/index', { title: 'Accueil', page: title })

<head>
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
        <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet">
        <script src='https://api.mapbox.com/mapbox-gl-js/v3.2.0/mapbox-gl.js'></script>
</head>

<main class="site_main">
  <div class="site_grid">
    <div class="left_page">
      <h1>{{ unesco.nameFr}}</h1>
      <p>{{ unesco.shortDescriptionFr }}</p>
    </div>
    <div class="right_page">
      <img src="https://media.sudouest.fr/10126973/1000x625/so-57ece51666a4bd19541a234f-ph0.jpg" alt="" class="site_img">
      <div class="site_temp">
        <div class="site_information">
          <p>Pays : {{ unesco.statesNames }}</p>
          <p>Date d'inscription : {{ unesco.dateInscribed }}</p>
          <p>Critères d'admission : </p> <a href="https://whc.unesco.org/fr/criteres">{{ unesco.criteriaTxt }}</a>
          <p>Taille : {{ unesco.areaHectares }} he</p>
          <p>No de dossier : {{ unesco.idNo }}</p>
          <p>Catégorie : {{ unesco.category }}</p>
        </div>
        <div class="add_site">
          <button>Ajouter dans les sites visitées</button>
          <button>Ajouter dans les sites marqués</button>
        </div>
      </div>
    </div>
    <div class="map">
      <h3>Monument sur la carte : </h3>
      <div id="map">
      </div>
    </div>
  </div>

</main>

<style>
  
  @import url("https://fonts.googleapis.com/css2?family=K2D:wght@300;400;500&display=swap");

  html {
    color: white;
  }

  a {
    color: #aebfe2ff;
  }

  .site_main {
    padding: 100px 100px 0 100px;
    background-color: #2c303d;
    height: 100%;
  }

  .site_temp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    background-color: #222937;
  }

  .site_grid {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
        "left right"
        "map map";
    background-color: #222937;
    padding: 10px;
    padding-bottom: 70px;
  }

  .left_page {
    grid-area: left;
    padding: 30px;
  }

  .right_page {
    grid-area: right;
    background-color: #2c303d;
    margin-top: 30px;
    margin-right: 30px;
    padding: 30px;
    border-radius: 7px;
  }

  .add_site > button {
    width: 90%;
    background-color: #3A4151;
    color: white;
    border-radius: 5px;
    margin: 20px 0;
    border-color: #C3C3C3;
    border-style: solid;
    padding: 20px 0;
    font-size: 16px;
  }

  
  .add_site > button:active {
    background-color: #232730ff !important;
    transform: translateY(200px)
  }

  .add_site > button:hover {
    cursor: pointer;
    background-color: #343a47ff;
  }

  .site_img {
    width: 100%;
    border: solid 3px black;
    border-radius: 7px;
  }

  .site_information {
    padding: 20px;
    margin-top: 20px;
  }

  .map {
    grid-area: map;
    width: auto;
    height: 700px;
    padding: 30px;
  }

</style>
<script>
  mapboxgl.accessToken = "pk.eyJ1IjoiNjdza2liaWRpc2NydW0iLCJhIjoiY21sYXdlamR3MGcyOTNlcXoxdHQ2bXliaiJ9.BXx6EzzxvsFrDg5yeo1LUQ";

  document.addEventListener('DOMContentLoaded', () => {
    const unesco = {{{ JSON.stringify(unesco) }}};

    let map;

    if (unesco.coordinates) {
      map = new mapboxgl.Map({
        container: "map",
        style: "mapbox://styles/mapbox/standard",
        projection: "equirectangular",
        zoom: 10,
        center: [unesco.coordinates.lon, unesco.coordinates.lat],
        interactive: false
      });

      map.on('load', () => {
        loadMarker(unesco.coordinates.lon, unesco.coordinates.lat);
      });
    }

    function loadMarker(lng, lat) {
      if (map) {
        const marker = new mapboxgl.Marker().setLngLat([lng, lat]).addTo(map);
      }
    }
  });
</script>
@end
