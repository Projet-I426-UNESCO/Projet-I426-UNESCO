@layout('components/layout/index', { title: 'Sites', page: 'sites' })

<main class="sites-main">
  <div class="controls">
    <div class="search-container">
      <details class="filter-dropdown">
        <summary class="search-pill filter-dropdown-toggle" title="{{ t('messages.filters.button_title') }}">
          <span class="material-symbols-outlined">tune</span>
        </summary>
        <div class="filter-dropdown-content">
          <div class="filter-section">
            <span class="filter-section-title">{{ t('messages.filters.category') }}</span>
            <div class="filter-options" data-filter-group="category">
              <label class="filter-option">
                <input type="checkbox" value="cultural" />
                <span>{{ t('messages.sites.filter_type_cultural') }}</span>
              </label>
              <label class="filter-option">
                <input type="checkbox" value="natural" />
                <span>{{ t('messages.sites.filter_type_natural') }}</span>
              </label>
              <label class="filter-option">
                <input type="checkbox" value="mixed" />
                <span>{{ t('messages.sites.filter_type_mixed') }}</span>
              </label>
            </div>
          </div>
          <div class="filter-section">
            <span class="filter-section-title">{{ t('messages.filters.region') }}</span>
            <div class="filter-options" data-filter-group="region"></div>
          </div>
          <div class="filter-section">
            <span class="filter-section-title">{{ t('messages.filters.country') }}</span>
            <input class="filter-input" type="text" data-filter-input="country"
              placeholder="{{ t('messages.filters.search_country_placeholder') }}" />
          </div>
          <div class="filter-section">
            <span class="filter-section-title">{{ t('messages.filters.continent') }}</span>
            <div class="filter-options" data-filter-group="continent"></div>
          </div>
          <div class="filter-section">
            <span class="filter-section-title">{{ t('messages.filters.date_inscribed') }}</span>
            <div class="filter-range">
              <input class="filter-input" type="number" data-filter-input="dateFrom"
                placeholder="{{ t('messages.filters.from') }}" />
              <input class="filter-input" type="number" data-filter-input="dateTo"
                placeholder="{{ t('messages.filters.to') }}" />
            </div>
          </div>
          <div class="filter-actions">
            <button type="button" class="filter-reset" data-filter-reset>
              {{ t('messages.filters.reset') }}
            </button>
          </div>
        </div>
      </details>
      <div class="search-pill">
        <span class="material-symbols-outlined">search</span>
        <input id="siteSearchInput" type="text" placeholder="{{ t('messages.sites.search_placeholder') }}" />
      </div>
    </div>
  </div>

  <div class="sites-grid">
    @each((unesco) in unescos)
      <a href="{{ route('site.show', { id: unesco.id }) }}" class="site-box"
        data-category="{{ unesco.category || '' }}"
        data-region="{{ unesco.region || '' }}"
        data-countries="{{ Array.isArray(unesco.statesNames) ? unesco.statesNames.join(', ') : (unesco.statesNames || '') }}"
        data-date-inscribed="{{ unesco.dateInscribed || '' }}">
        @if(unesco.localImageThumb)
          <img src="{{ unesco.localImageThumb }}" class="site-box-img" />
        @else
          <img src="https://placehold.co/300x200" class="site-box-img" />
        @end

        <div class="site-box-info">
          <h3>{{ unesco.nameFr }}</h3>
          <p>{{ unesco.statesNames }}</p>
        </div>

        @if(unesco.added)
          <button class="delete-btn">
            <span class="material-symbols-outlined">delete</span>
            {{ t('messages.sites.remove_from_list') }}
          </button>
        @else
          <button class="btn-primary">
            <span class="material-symbols-outlined">add</span>
            {{ t('messages.sites.add_to_list') }}
          </button>
        @end

        @if(unesco.visited)
          <button class="visited-btn">
            <span class="material-symbols-outlined">check</span>
            {{ t('messages.sites.site_visited') }}
          </button>
        @else
          <button class="action-btn btn-visit">
            <span class="material-symbols-outlined">check</span>
            {{ t('messages.sites.mark_as_visited') }}
          </button>
        @end
      </a>
    @end
  </div>

</main>

<script>
  const searchInput = document.getElementById("siteSearchInput");
  const filterCategoryContainer = document.querySelector('[data-filter-group="category"]');
  const filterRegionContainer = document.querySelector('[data-filter-group="region"]');
  const filterContinentContainer = document.querySelector('[data-filter-group="continent"]');
  const filterCountryInput = document.querySelector('[data-filter-input="country"]');
  const filterDateFromInput = document.querySelector('[data-filter-input="dateFrom"]');
  const filterDateToInput = document.querySelector('[data-filter-input="dateTo"]');
  const filterResetButton = document.querySelector('[data-filter-reset]');
  const siteCards = Array.from(document.querySelectorAll(".site-box"));

  function normalizeSearchValue(value) {
    return (value || "")
      .toString()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .toLowerCase()
      .trim();
  }

  const continentByRegion = {
    "Europe and North America": ["Europe", "North America"],
    "Latin America and the Caribbean": ["South America", "North America"],
    "Asia and the Pacific": ["Asia", "Oceania"],
    "Arab States": ["Asia", "Africa"],
    "Africa": ["Africa"],
  };

  function getContinentsByRegion(region) {
    return continentByRegion[region] || [];
  }

  function renderCheckboxOptions(container, values) {
    if (!container) return;
    container.innerHTML = values
      .map((value, index) => {
        const inputId = `${container.dataset.filterGroup || "filter"}-${index}`;
        return `
          <label class="filter-option" for="${inputId}">
            <input type="checkbox" id="${inputId}" value="${normalizeSearchValue(value)}" />
            <span>${value}</span>
          </label>
        `;
      })
      .join("");
  }

  function getSelectedFilterValues(container) {
    if (!container) return [];
    return Array.from(container.querySelectorAll('input[type="checkbox"]:checked')).map(
      (input) => input.value
    );
  }

  function matchesAdvancedFilters(site, options) {
    const {
      selectedCategories,
      selectedRegions,
      selectedContinents,
      countryQuery,
      dateFrom,
      dateTo,
    } = options;

    if (selectedCategories.length) {
      const categoryValue = normalizeSearchValue(site.dataset.category);
      if (!categoryValue || !selectedCategories.includes(categoryValue)) {
        return false;
      }
    }

    if (selectedRegions.length) {
      const regionValue = normalizeSearchValue(site.dataset.region);
      if (!regionValue || !selectedRegions.includes(regionValue)) {
        return false;
      }
    }

    if (selectedContinents.length) {
      const continents = getContinentsByRegion(site.dataset.region).map(normalizeSearchValue);
      if (!continents.some((continent) => selectedContinents.includes(continent))) {
        return false;
      }
    }

    if (countryQuery) {
      const countries = normalizeSearchValue(site.dataset.countries);
      if (!countries.includes(countryQuery)) {
        return false;
      }
    }

    const dateValue = Number.parseInt(site.dataset.dateInscribed || "", 10);
    if (!Number.isNaN(dateFrom) && (!dateValue || dateValue < dateFrom)) {
      return false;
    }

    if (!Number.isNaN(dateTo) && (!dateValue || dateValue > dateTo)) {
      return false;
    }

    return true;
  }

  function filterSites() {
    const searchQuery = normalizeSearchValue(searchInput?.value);
    const selectedCategories = getSelectedFilterValues(filterCategoryContainer);
    const selectedRegions = getSelectedFilterValues(filterRegionContainer);
    const selectedContinents = getSelectedFilterValues(filterContinentContainer);
    const countryQuery = normalizeSearchValue(filterCountryInput?.value);
    const dateFrom = Number.parseInt(filterDateFromInput?.value || "", 10);
    const dateTo = Number.parseInt(filterDateToInput?.value || "", 10);

    siteCards.forEach((site) => {
      const siteName = normalizeSearchValue(site.querySelector(".site-box-info h3")?.textContent);
      const countryName = normalizeSearchValue(site.dataset.countries);
      const siteText = `${siteName} ${countryName}`;

      const matchesSearch = !searchQuery || siteText.includes(searchQuery);
      const matchesAdvanced = matchesAdvancedFilters(site, {
        selectedCategories,
        selectedRegions,
        selectedContinents,
        countryQuery,
        dateFrom,
        dateTo,
      });

      site.style.display = matchesSearch && matchesAdvanced ? "flex" : "none";
    });
  }

  function resetAdvancedFilters() {
    document
      .querySelectorAll('.filter-dropdown-content input[type="checkbox"]')
      .forEach((input) => {
        input.checked = false;
      });

    if (filterCountryInput) {
      filterCountryInput.value = "";
    }

    if (filterDateFromInput) {
      filterDateFromInput.value = "";
    }

    if (filterDateToInput) {
      filterDateToInput.value = "";
    }

    filterSites();
  }

  function setupAdvancedFilters() {
    const regions = [...new Set(siteCards.map((site) => site.dataset.region).filter(Boolean))].sort();
    const continents = [
      ...new Set(regions.flatMap((region) => getContinentsByRegion(region)).filter(Boolean)),
    ].sort();

    renderCheckboxOptions(filterRegionContainer, regions);
    renderCheckboxOptions(filterContinentContainer, continents);

    document.querySelectorAll(".filter-dropdown-content input").forEach((input) => {
      const eventName = input.type === "checkbox" ? "change" : "input";
      input.addEventListener(eventName, filterSites);
    });

    if (filterResetButton) {
      filterResetButton.addEventListener("click", resetAdvancedFilters);
    }
  }

  if (searchInput) {
    searchInput.addEventListener("input", filterSites);
  }

  setupAdvancedFilters();
</script>

<style>

  @import url("https://fonts.googleapis.com/css2?family=K2D:wght@300;400;500&display=swap");

  html {
    color: white;
  }

  a {
    color: #aebfe2ff;
  }

  .site_main {
    padding: 100px 100px 80px 100px;
    background-color: #2c303d;
    height: 100%;
  }

  .site_temp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    background-color: #222937;
  }

  .site_grid {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
    "left right"
    "map map";
    background-color: #222937;
    padding: 10px;
    padding-bottom: 70px;
  }

  .left_page {
    grid-area: left;
    padding: 30px;
  }

  .right_page {
    grid-area: right;
    background-color: #2c303d;
    margin-top: 30px;
    margin-right: 30px;
    padding: 30px;
    border-radius: 7px;
  }

  .add_site > button {
    width: 90%;
    background-color: #737df3;
    border-radius: 12px;
    margin: 20px 0;
    padding: 20px 0;
    font-size: 16px;
  }


  .add_site > button:active {
    background-color: #4957ee !important;
  }

  .add_site > button:hover {
    cursor: pointer;
    background-color: #5f6cf5;
  }

  .site_img {
    width: 100%;
    border: solid 3px black;
    border-radius: 7px;
  }

  .site_information {
    padding: 20px;
    margin-top: 20px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .map_container {
    grid-area: map;
    width: auto;
    height: 700px;
    padding: 30px;
    cursor: default !important;
  }

</style>
<script>
  mapboxgl.accessToken = "pk.eyJ1IjoiNjdza2liaWRpc2NydW0iLCJhIjoiY21sYXdlamR3MGcyOTNlcXoxdHQ2bXliaiJ9.BXx6EzzxvsFrDg5yeo1LUQ";

  const csrfToken = "{{ csrfToken }}";

  document.addEventListener('DOMContentLoaded', () => {
    const unesco = {{{ JSON.stringify(unesco) }}};

    for (let i = 0; i < 2; i++) {
      flipVisitSiteUI(unesco.id)
      flipMarkSiteUI(unesco.id)
    }

    let map;

    if (unesco.coordinates) {
      map = new mapboxgl.Map({
        container: "map",
        style: "mapbox://styles/mapbox/standard",
        projection: "equirectangular",
        zoom: 10,
        center: [unesco.coordinates.lon, unesco.coordinates.lat],
        dragPan: false,
        touchZoomRotate: false,
        dragRotate: false,
        keyboard: false,
        doubleClickZoom: false,
        minZoom: 3
      });

      map.scrollZoom.disable();
      map.scrollZoom.enable({ around: 'center' });

      map.touchZoomRotate.disable();
      map.touchZoomRotate.enable({ around: 'center' });

      // disable the grab cursor
      map.getCanvas().style.cursor = 'default';

      map.on('load', () => {
        loadMarker(unesco.coordinates.lon, unesco.coordinates.lat);
      });

      map.addControl(new mapboxgl.NavigationControl({
        showCompass: false,
        showZoom: true,
        visualizePitch: false
      }), 'top-right');
    }

    function loadMarker(lng, lat) {
      if (map) {
        const marker = new mapboxgl.Marker().setLngLat([lng, lat]).addTo(map);
        marker.getElement().style.cursor = 'default';
      }
    }
  });

  const markersData = {{{ JSON.stringify(markers) }}};

  async function visitSite(url, unescoId) {
    try {
      const res = await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrfToken
        }
      });

      if (!res.ok) throw new Error("Request failed");

      console.log(`Visiting sequence with unescoId : ${unescoId} `);

      flipVisitSiteUI(unescoId)

    } catch (err) {
      console.error(err);
    }
  }

  async function markSite(url, unescoId) {
    try {
      const res = await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrfToken
        }
      });

      if (!res.ok) throw new Error("Request failed");

      console.log(`Marking sequence with unescoId : ${unescoId} `);

      flipMarkSiteUI(unescoId)

    } catch (err) {
      console.error(err);
    }
  }

  function flipVisitSiteUI(unescoId) {
    // if the marker exists Flip the isVisited value in UI
    if (markersData) {
      const marker = markersData.find((marker) => marker.unescoId == unescoId)
      const button = document.getElementById("visitSiteBtn")
      console.log(button)
      if (marker) {
        markersData[markersData.findIndex((marker) => marker.unescoId == unescoId)].isVisited = !marker.isVisited
        button.innerText = marker.isVisited ? "Enlever de mes visites" : "Ajouter à mes visites"
        // Flips the isVisited in the gotten data, it modifies the now local data, not the distant one, simply to keep the UI up to date.
      } else {
        markersData.push({isMarked: 0, isVisited: 1, unescoId: unescoId})
        button.innerText = "Enlever de mes visites"
      }
    }
  }

  function flipMarkSiteUI(unescoId) {
    // if the marker exists Flip the isMarked value in UI
    if (markersData) {
      const marker = markersData.find((marker) => marker.unescoId == unescoId)
      const button = document.getElementById("markSiteBtn")
      console.log(button)
      if (marker) {
        markersData[markersData.findIndex((marker) => marker.unescoId == unescoId)].isMarked = !marker.isMarked
        button.innerText = marker.isMarked ? "Démarquer le Site" : "Marquer le Site"
        // Flips the isMarked in the gotten data, it modifies the now local data, not the distant one, simply to keep the UI up to date.
      } else {
        // If the marker doesn't exist we manually, locally create it as the db would and change it's values manually
        markersData.push({isMarked: 1, isVisited: 0, unescoId: unescoId})
        button.innerText = "Démarquer le Site"
      }
    }
  }
</script>
@end
