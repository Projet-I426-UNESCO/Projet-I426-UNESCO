@layout('components/layout/index', { title: 'Accueil', page: title })

<head>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet">
  <script src='https://api.mapbox.com/mapbox-gl-js/v3.2.0/mapbox-gl.js'></script>
</head>

<main class="site_main">
  <div class="site_grid">
    <div class="left_page">
      <h1>{{ unesco.nameFr}}</h1>
      <p>{{ unesco.shortDescriptionFr }}</p>
    </div>
    <div class="right_page">
      <img src="{{ img ? img : 'https://media.sudouest.fr/10126973/1000x625/so-57ece51666a4bd19541a234f-ph0.jpg' }}" alt="" class="site_img">
      <div class="site_temp">
        <div class="site_information">
          <p>Pays : {{ unesco.statesNames }}</p>
          <p>Date d'inscription : {{ unesco.dateInscribed }}</p> <p>Critères d'admission : </p> <a href="https://whc.unesco.org/fr/criteres">{{ unesco.criteriaTxt }}</a>
          <p>Taille : {{ unesco.areaHectares }} he</p>
          <p>No de dossier : {{ unesco.idNo }}</p>
          <p>Catégorie : {{ unesco.category }}</p>
        </div>
        <div class="add_site">
          @if(auth.user)
            <button class="action-btn btn-add" id="visitSiteBtn" onclick="visitSite('{{ route('marker.visit', { unescoId: unesco.id }) }}', {{unesco.id}})">
              Ajouter à mes visites
            </button>

            <button class="action-btn btn-visit" id="markSiteBtn" onclick="markSite('{{ route('marker.mark', { unescoId: unesco.id }) }}', {{unesco.id}})">
              Marquer le Site
            </button>
          @end
        </div>
      </div>
    </div>
    <div class="map_container">
      <h3>Monument sur la carte : </h3>
      <div id="map">
      </div>
    </div>
  </div>

</main>

<style>

  @import url("https://fonts.googleapis.com/css2?family=K2D:wght@300;400;500&display=swap");

  html {
    color: white;
  }

  a {
    color: #aebfe2ff;
  }

  .site_main {
    padding: 100px 100px 80px 100px;
    background-color: #2c303d;
    height: 100%;
  }

  .site_temp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    background-color: #222937;
  }

  .site_grid {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
    "left right"
    "map map";
    background-color: #222937;
    padding: 10px;
    padding-bottom: 70px;
  }

  .left_page {
    grid-area: left;
    padding: 30px;
  }

  .right_page {
    grid-area: right;
    background-color: #2c303d;
    margin-top: 30px;
    margin-right: 30px;
    padding: 30px;
    border-radius: 7px;
  }

  .add_site > button {
    width: 90%;
    background-color: #737df3;
    border-radius: 12px;
    margin: 20px 0;
    padding: 20px 0;
    font-size: 16px;
  }


  .add_site > button:active {
    background-color: #4957ee !important;
  }

  .add_site > button:hover {
    cursor: pointer;
    background-color: #5f6cf5;
  }

  .site_img {
    width: 100%;
    border: solid 3px black;
    border-radius: 7px;
  }

  .site_information {
    padding: 20px;
    margin-top: 20px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .map_container {
    grid-area: map;
    width: auto;
    height: 700px;
    padding: 30px;
    cursor: default !important;
  }

</style>
<script>
  mapboxgl.accessToken = "pk.eyJ1IjoiNjdza2liaWRpc2NydW0iLCJhIjoiY21sYXdlamR3MGcyOTNlcXoxdHQ2bXliaiJ9.BXx6EzzxvsFrDg5yeo1LUQ";

  const csrfToken = "{{ csrfToken }}";

  document.addEventListener('DOMContentLoaded', () => {
    const unesco = {{{ JSON.stringify(unesco) }}};

    for (let i = 0; i < 2; i++) {
      flipVisitSiteUI(unesco.id)
      flipMarkSiteUI(unesco.id)
    }

    let map;

    if (unesco.coordinates) {
      map = new mapboxgl.Map({
        container: "map",
        style: "mapbox://styles/mapbox/standard",
        projection: "equirectangular",
        zoom: 10,
        center: [unesco.coordinates.lon, unesco.coordinates.lat],
        dragPan: false,
        touchZoomRotate: false,
        dragRotate: false,
        keyboard: false,
        doubleClickZoom: false,
        minZoom: 3
      });

      map.scrollZoom.disable();
      map.scrollZoom.enable({ around: 'center' });

      map.touchZoomRotate.disable();
      map.touchZoomRotate.enable({ around: 'center' });

      // disable the grab cursor
      map.getCanvas().style.cursor = 'default';

      map.on('load', () => {
        loadMarker(unesco.coordinates.lon, unesco.coordinates.lat);
      });

      map.addControl(new mapboxgl.NavigationControl({
        showCompass: false,
        showZoom: true,
        visualizePitch: false
      }), 'top-right');
    }

    function loadMarker(lng, lat) {
      if (map) {
        const marker = new mapboxgl.Marker().setLngLat([lng, lat]).addTo(map);
        marker.getElement().style.cursor = 'default';
      }
    }
  });

  const markersData = {{{ JSON.stringify(markers) }}};

  async function visitSite(url, unescoId) {
    try {
      const res = await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrfToken
        }
      });

      if (!res.ok) throw new Error("Request failed");

      console.log(`Visiting sequence with unescoId : ${unescoId} `);

      flipVisitSiteUI(unescoId)

    } catch (err) {
      console.error(err);
    }
  }

  async function markSite(url, unescoId) {
    try {
      const res = await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrfToken
        }
      });

      if (!res.ok) throw new Error("Request failed");

      console.log(`Marking sequence with unescoId : ${unescoId} `);

      flipMarkSiteUI(unescoId)

    } catch (err) {
      console.error(err);
    }
  }

  function flipVisitSiteUI(unescoId) {
    // if the marker exists Flip the isVisited value in UI
    if (markersData) {
      const marker = markersData.find((marker) => marker.unescoId == unescoId)
      const button = document.getElementById("visitSiteBtn")
      console.log(button)
      if (marker) {
        markersData[markersData.findIndex((marker) => marker.unescoId == unescoId)].isVisited = !marker.isVisited
        button.innerText = marker.isVisited ? "Enlever de mes visites" : "Ajouter à mes visites"
        // Flips the isVisited in the gotten data, it modifies the now local data, not the distant one, simply to keep the UI up to date.
      } else {
        markersData.push({isMarked: 0, isVisited: 1, unescoId: unescoId})
        button.innerText = "Enlever de mes visites"
      }
    }
  }

  function flipMarkSiteUI(unescoId) {
    // if the marker exists Flip the isMarked value in UI
    if (markersData) {
      const marker = markersData.find((marker) => marker.unescoId == unescoId)
      const button = document.getElementById("markSiteBtn")
      console.log(button)
      if (marker) {
        markersData[markersData.findIndex((marker) => marker.unescoId == unescoId)].isMarked = !marker.isMarked
        button.innerText = marker.isMarked ? "Démarquer le Site" : "Marquer le Site"
        // Flips the isMarked in the gotten data, it modifies the now local data, not the distant one, simply to keep the UI up to date.
      } else {
        // If the marker doesn't exist we manually, locally create it as the db would and change it's values manually
        markersData.push({isMarked: 1, isVisited: 0, unescoId: unescoId})
        button.innerText = "Démarquer le Site"
      }
    }
  }
</script>
@end
