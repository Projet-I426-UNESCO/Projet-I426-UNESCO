@layout('components/layout/index', { title: i18n.locale === 'en' ? (unesco.nameEn || unesco.nameFr) : (unesco.nameFr ||
unesco.nameEn), page: 'sites' })

<head>
  <link rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.3.0/mapbox-gl.css" rel="stylesheet">
  <script src='https://api.mapbox.com/mapbox-gl-js/v3.2.0/mapbox-gl.js'></script>
</head>

<main class="site_main">
  <div class="site_grid">
    <div class="left_page">
      <h1>{{ i18n.locale === 'en' ? (unesco.nameEn || unesco.nameFr) : (unesco.nameFr || unesco.nameEn) }}</h1>
      <p>{{ i18n.locale === 'en' ? (unesco.shortDescriptionEn || unesco.shortDescriptionFr) : (unesco.shortDescriptionFr
        || unesco.shortDescriptionEn) }}</p>
    </div>
    <div class="right_page">
      <img src="{{ img ? img : unesco.localImageMain }}" alt="" class="site_img">
      <div class="site_temp">
        <div class="site_information">
          <p>{{ t('messages.site.country') }} : {{ unesco.statesNames }}</p>
          <p>{{ t('messages.site.inscription_date') }} : {{ unesco.dateInscribed }}</p>
          <p>{{ t('messages.site.criteria') }} : </p> <a href="https://whc.unesco.org/fr/criteres">{{ unesco.criteriaTxt
            }}</a>
          <p>{{ t('messages.site.size') }} : {{ unesco.areaHectares }} he</p>
          <p>{{ t('messages.site.dossier_no') }} : {{ unesco.idNo }}</p>
          <p>{{ t('messages.site.category') }} : {{ unesco.category }}</p>
        </div>
        <div class="add_site">
          @if(auth.user)
          <button class="action-btn btn-add" id="visitSiteBtn"
            onclick="visitSite('{{ route('marker.visit', { unescoId: unesco.id }) }}', {{unesco.id}})">
            {{ t('messages.home.add_to_visited') }}
          </button>

          <button class="action-btn btn-visit" id="markSiteBtn"
            onclick="markSite('{{ route('marker.mark', { unescoId: unesco.id }) }}', {{unesco.id}})">
            {{ t('messages.home.mark_site') }}
          </button>
          @end
        </div>
      </div>
    </div>
    <div class="map_container">
      <h3>{{ t('messages.site.map_title') }} </h3>
      <div id="map">
      </div>
    </div>
  </div>

</main>

<style>
  @import url("https://fonts.googleapis.com/css2?family=K2D:wght@300;400;500&display=swap");

  html {
    color: white;
  }

  a {
    color: #aebfe2ff;
  }

  .site_main {
    padding: 100px 100px 80px 100px;
    background-color: #2c303d;
    height: 100%;
  }

  .site_temp {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    background-color: #222937;
  }

  .site_grid {
    display: grid;
    gap: 10px;
    grid-template-columns: 1fr 1fr;
    grid-template-areas:
      "left right"
      "map map";
    background-color: #222937;
    padding: 10px;
    padding-bottom: 70px;
  }

  .left_page {
    grid-area: left;
    padding: 30px;
  }

  .right_page {
    grid-area: right;
    background-color: #2c303d;
    margin-top: 30px;
    margin-right: 30px;
    padding: 30px;
    border-radius: 7px;
  }

  .add_site>button {
    width: 90%;
    background-color: #737df3;
    border-radius: 12px;
    margin: 20px 0;
    padding: 20px 0;
    font-size: 16px;
  }


  .add_site>button:active {
    background-color: #4957ee !important;
  }

  .add_site>button:hover {
    cursor: pointer;
    background-color: #5f6cf5;
  }

  .site_img {
    width: 100%;
    border: solid 3px black;
    border-radius: 7px;
  }

  .site_information {
    padding: 20px;
    margin-top: 20px;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .map_container {
    grid-area: map;
    width: auto;
    height: 700px;
    padding: 30px;
    cursor: default !important;
  }

  @media screen and (max-width: 1200px) {
    .site_main {
      padding: 20px;
    }

    .site_grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "left"
        "right"
        "map";
    }

    .right_page {
      margin: 0;
      margin-top: 30px;
    }

    body {
      display: block;
      margin-left: 0;
    }

    body.page-home {
      height: 100dvh;
      overflow: hidden;
    }

    .auth-pill-group {
      display: none;
    }

    .main-header {
      width: 100%;
      min-width: 0;
      height: auto;
      padding: 12px;
      border-right: none;
      border-bottom: 1px solid #334155;
      background-size: 16px 16px;
      position: sticky;
      top: 0;
      z-index: 300;
    }

    .header-top {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      text-align: left;
    }

    .logo h1 {
      font-size: 32px;
      margin: 0;
    }

    /* Hamburger button */
    .menu-toggle {
      width: 42px;
      height: 42px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      background-color: #141827;
      color: white;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }

    .menu-toggle .material-symbols-outlined {
      font-size: 28px;
      color: inherit;
    }

    .menu-toggle .icon-close {
      display: none;
    }

    .menu-toggle.is-open .icon-open {
      display: none;
    }

    .menu-toggle.is-open .icon-close {
      display: block;
    }

    .header-content {
      position: fixed;
      top: 74px;
      left: 12px;
      right: 12px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 12px;
      background-color: #1e2533;
      border: 1px solid #334155;
      border-radius: 14px;
      box-shadow: 0 16px 38px rgba(0, 0, 0, 0.45);
      max-height: calc(100dvh - 86px);
      overflow-y: auto;
      scrollbar-width: none;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      z-index: 250;
    }

    .header-content::-webkit-scrollbar {
      display: none;
    }

    .main-header.is-open .header-content {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: translateY(0);
    }

    .search-container {
      width: calc(100% - 40px);
    }

    #primaryNav {
      display: grid;
      gap: 8px;
      flex: none;
    }

    .menu-item {
      flex-direction: row;
      justify-content: flex-start;
      gap: 12px;
      background-color: #141827;
      border-radius: 12px;
      padding: 12px;
    }

    .menu-item p {
      font-size: 16px;
    }

    #primaryNav .menu-item .material-symbols-outlined {
      font-size: 24px;
    }

    .lang-popup {
      position: absolute;
      bottom: 30px;
      top: -69px;
      right: 0;
      bottom: auto;
      transform: translateY(10px);
      background-color: #1e2533;
      border: 1px solid #334155;
      border-radius: 12px;
      width: 140px;
      padding: 10px 0;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
      opacity: 0;
      visibility: hidden;
      transition: all 0.2s ease;
      z-index: 100;
    }

    .lang-popup.show {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .lang-container {
      margin-bottom: 0;
      padding-bottom: 4px;
    }

    .language-picker {
      justify-content: space-between;
    }

    .lang-popup {}

    .home-main {
      grid-template-columns: 1fr;
      grid-template-rows: minmax(0, 55%) minmax(0, 45%);
      height: calc(100dvh - 74px);
      min-height: 0;
    }

    .explorer-container {
      height: 100%;
      min-height: 0;
    }

    .controls {
      padding: 10px;
      gap: 10px;
      flex-direction: column;
      align-items: stretch;
    }

    .user-profile {
      width: 100%;
    }

    .search-pill input {
      width: 100%;
      min-width: 0;
    }

    aside {
      width: 100%;
      height: 100%;
      max-height: none;
      min-height: 0;
    }

    .stats-footer-container {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .site_main {
      padding: 20px;
    }

    .site_grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "left"
        "right"
        "map";
    }

    .right_page {
      margin: 0;
      margin-top: 30px;
    }
  }
</style>
<script>
  mapboxgl.accessToken = "pk.eyJ1IjoiNjdza2liaWRpc2NydW0iLCJhIjoiY21sYXdlamR3MGcyOTNlcXoxdHQ2bXliaiJ9.BXx6EzzxvsFrDg5yeo1LUQ";

  const csrfToken = "{{ csrfToken }}";
  const tAddVisited = "{{ t('messages.home.add_to_visited') }}";
  const tRemoveVisited = "{{ t('messages.home.remove_from_visited') }}";
  const tMarkSite = "{{ t('messages.home.mark_site') }}";
  const tUnmarkSite = "{{ t('messages.home.unmark_site') }}";

  document.addEventListener('DOMContentLoaded', () => {
    const unesco = {{{ JSON.stringify(unesco)
  }}};

  for (let i = 0; i < 2; i++) {
    flipVisitSiteUI(unesco.id)
    flipMarkSiteUI(unesco.id)
  }

  let map;

  if (unesco.coordinates) {
    map = new mapboxgl.Map({
      container: "map",
      style: "mapbox://styles/mapbox/standard",
      projection: "equirectangular",
      zoom: 10,
      center: [unesco.coordinates.lon, unesco.coordinates.lat],
      dragPan: false,
      touchZoomRotate: false,
      dragRotate: false,
      keyboard: false,
      doubleClickZoom: false,
      minZoom: 3
    });

    map.scrollZoom.disable();
    map.scrollZoom.enable({ around: 'center' });

    map.touchZoomRotate.disable();
    map.touchZoomRotate.enable({ around: 'center' });

    // disable the grab cursor
    map.getCanvas().style.cursor = 'default';

    map.on('load', () => {
      loadMarker(unesco.coordinates.lon, unesco.coordinates.lat);
    });

    map.addControl(new mapboxgl.NavigationControl({
      showCompass: false,
      showZoom: true,
      visualizePitch: false
    }), 'top-right');
  }

  function loadMarker(lng, lat) {
    if (map) {
      const marker = new mapboxgl.Marker().setLngLat([lng, lat]).addTo(map);
      marker.getElement().style.cursor = 'default';
    }
  }
  });

  const markersData = {{{ JSON.stringify(markers) }}};

  async function visitSite(url, unescoId) {
    try {
      const res = await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrfToken
        }
      });

      if (!res.ok) throw new Error("Request failed");

      console.log(`Visiting sequence with unescoId : ${unescoId} `);

      flipVisitSiteUI(unescoId)

    } catch (err) {
      console.error(err);
    }
  }

  async function markSite(url, unescoId) {
    try {
      const res = await fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-csrf-token": csrfToken
        }
      });

      if (!res.ok) throw new Error("Request failed");

      console.log(`Marking sequence with unescoId : ${unescoId} `);

      flipMarkSiteUI(unescoId)

    } catch (err) {
      console.error(err);
    }
  }

  function flipVisitSiteUI(unescoId) {
    // if the marker exists Flip the isVisited value in UI
    if (markersData) {
      const marker = markersData.find((marker) => marker.unescoId == unescoId)
      const button = document.getElementById("visitSiteBtn")
      if (button) {
        if (marker) {
          markersData[markersData.findIndex((marker) => marker.unescoId == unescoId)].isVisited = !marker.isVisited
          button.innerText = marker.isVisited ? tRemoveVisited : tAddVisited
          // Flips the isVisited in the gotten data, it modifies the now local data, not the distant one, simply to keep the UI up to date.
        } else {
          markersData.push({ isMarked: 0, isVisited: 1, unescoId: unescoId })
          button.innerText = tRemoveVisited
        }
      }
    }
  }

  function flipMarkSiteUI(unescoId) {
    // if the marker exists Flip the isMarked value in UI
    if (markersData) {
      const marker = markersData.find((marker) => marker.unescoId == unescoId)
      const button = document.getElementById("markSiteBtn")
      if (button) {
        if (marker) {
          markersData[markersData.findIndex((marker) => marker.unescoId == unescoId)].isMarked = !marker.isMarked
          button.innerText = marker.isMarked ? tUnmarkSite : tMarkSite
          // Flips the isMarked in the gotten data, it modifies the now local data, not the distant one, simply to keep the UI up to date.
        } else {
          // If the marker doesn't exist we manually, locally create it as the db would and change it's values manually
          markersData.push({ isMarked: 1, isVisited: 0, unescoId: unescoId })
          button.innerText = tUnmarkSite
        }
      }
    }
  }
</script>
@end