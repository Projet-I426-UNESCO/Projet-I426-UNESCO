@layout('components/layout/index', { title: 'Accueil', page: 'home' })

<style>
  body.page-home {
    display: grid !important;
    grid-template-columns: 7% 1fr 344px !important;
    grid-template-rows: 100vh !important;
    width: 100vw !important;
    height: 100vh !important;
    margin: 0 !important;
    overflow: hidden !important;
    background-color: #0f172a;
  }

  .explorer-container {
    grid-column: 2;
    height: 100vh;
    padding: 15px;
    box-sizing: border-box;
    position: relative;
  }

  .map-container {
    width: 100%;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #334155;
  }

  #map { width: 100%; height: 100%; }

  aside {
    grid-column: 3;
    height: 100vh;
    background: #141827;
    border-left: 1px solid #334155;
    display: flex;
    flex-direction: column;
    z-index: 10;
  }

  .sidebar-header {
    padding: 20px;
    border-bottom: 1px solid #334155;
    background: #141827;
  }

  #searchInput {
    width: 100%;
    padding: 12px;
    border-radius: 8px;
    border: 1px solid #334155;
    background: #1e2533;
    color: white;
  }

  #aside-dynamic-content {
    flex: 1;
    overflow-y: auto !important;
    padding: 15px;
  }

  .site-card {
    display: flex;
    gap: 12px;
    background: #1e2533;
    border-radius: 12px;
    padding: 10px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: 0.2s;
  }

  .site-card:hover { background: #2b3447; transform: translateX(-5px); }
  .site-card img { width: 60px; height: 60px; border-radius: 8px; object-fit: cover; }
  .card-info h4 { color: white; margin: 0; font-size: 14px; }
  .card-info p { color: #9ca3af; font-size: 12px; margin: 4px 0 0; }

  #aside-dynamic-content::-webkit-scrollbar { width: 6px; }
  #aside-dynamic-content::-webkit-scrollbar-thumb { background: #6366f1; border-radius: 10px; }
</style>

<main class="explorer-container">
  <div class="map-container">
    <div id="map"></div>
  </div>
</main>

<aside>
  <div class="sidebar-header">
    <div style="display: flex; align-items: center; gap: 10px; color: white; margin-bottom: 15px;">
      <input type="checkbox" id="markerToggle" checked />
      <span style="font-size: 13px;">Marqueurs</span>
    </div>
    <input type="text" id="searchInput" placeholder="Rechercher..." />
  </div>

  <div id="aside-dynamic-content">
    @each(unesco in unescos)
      @if(unesco.coordinates)
        <div class="site-card" onclick="zoomToLocation({{ unesco.coordinates.lon }}, {{ unesco.coordinates.lat }})">
          <img src="{{ unesco.mainImageUrl }}" />
          <div class="card-info">
            <h4>{{ unesco.nameEn }}</h4>
            <p>{{ unesco.statesNames }}</p>
          </div>
        </div>
      @end
    @end
  </div>
</aside>

<script>
  const unescosData = {{{ JSON.stringify(unescos) }}};
  mapboxgl.accessToken = "pk.eyJ1IjoiNjdza2liaWRpc2NydW0iLCJhIjoiY21sYXdlamR3MGcyOTNlcXoxdHQ2bXliaiJ9.BXx6EzzxvsFrDg5yeo1LUQ";

  const map = new mapboxgl.Map({
    container: "map",
    style: "mapbox://styles/mapbox/standard",
    projection: "globe",
    zoom: 1.8,
    center: [10, 20]
  });

  let markerInstances = [];
  let markersVisible = true;
  let rainbowEnabled = false;

  function filterContent() {
    const searchTerm = document.getElementById("searchInput").value.toLowerCase();
    const filteredData = unescosData.filter(item => {
      const name = item.nameEn ? item.nameEn.toLowerCase() : "";
      const states = item.states ? item.states.toLowerCase() : "";
      return name.includes(searchTerm) || states.includes(searchTerm);
    });
    updateMarkers(filteredData);
    updateAside(filteredData);
  }

  function updateMarkers(data) {
    markerInstances.forEach(m => m.remove());
    markerInstances = [];
    if (!markersVisible) return;
    data.forEach(h => {
      if (h.coordinates) {
        const m = new mapboxgl.Marker({ color: "#6366f1" })
          .setLngLat([h.coordinates.lon, h.coordinates.lat])
          .addTo(map);
        markerInstances.push(m);
      }
    });
  }

  function updateAside(data) {
    const content = document.getElementById("aside-dynamic-content");
    content.innerHTML = '';
    data.forEach(u => {
      const card = document.createElement('div');
      card.className = 'site-card';
      card.onclick = () => zoomToLocation(u.coordinates.lon, u.coordinates.lat);
      card.innerHTML = `<img src="${u.mainImageUrl}" /><div class="card-info"><h4>${u.nameEn}</h4><p>${u.states}</p></div>`;
      content.appendChild(card);
    });
  }

  function zoomToLocation(lng, lat) {
    map.flyTo({ center: [lng, lat], zoom: 10, duration: 3000, essential: true });
  }

  const konamiCode = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"];
  let konamiIndex = 0;

  window.addEventListener("keydown", e => {
    if (e.key === konamiCode[konamiIndex]) {
      konamiIndex++;
      if (konamiIndex === konamiCode.length) {
        rainbowEnabled = !rainbowEnabled;
        konamiIndex = 0;
        console.log("Konami Activated 🌈");
      }
    } else { konamiIndex = 0; }
  });

  function rainbowColor() {
    const t = Date.now() / 1000;
    const hue = (t % 5) * 360 / 5;
    return `hsl(${hue}, 100%, 50%)`;
  }

  map.on("style.load", () => {
    function animate() {
      map.setFog({
        range: [0.5, 10],
        color: rainbowEnabled ? rainbowColor() : "white",
        "high-color": "#245cdf",
        "space-color": "#000000"
      });
      requestAnimationFrame(animate);
    }
    animate();
  });

  document.getElementById("searchInput").addEventListener("input", filterContent);
  document.getElementById("markerToggle").addEventListener("change", (e) => {
    markersVisible = e.target.checked;
    filterContent();
  });

  map.on("load", () => {
    map.resize();
    filterContent();
  });
</script>
@end
