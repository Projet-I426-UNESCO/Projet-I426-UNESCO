@layout('components/layout/index', { title: 'Accueil', page: 'home' })

<style>
  body.page-home {
    display: grid !important;
    grid-template-columns: 7% 1fr 344px !important;
    grid-template-rows: 100vh !important;
    width: 100vw !important;
    height: 100vh !important;
    margin: 0 !important;
    overflow: hidden !important;
    background-color: #0f172a;
  }

  .explorer-container {
    grid-column: 2;
    height: 100vh;
    padding: 15px;
    box-sizing: border-box;
    position: relative;
  }

  .map-search-overlay {
    position: absolute;
    top: 30px;
    left: 30px;
    z-index: 10;
    width: 320px;
  }

  #searchInput {
    width: 100%;
    padding: 12px 18px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(30, 37, 51, 0.85);
    backdrop-filter: blur(10px);
    color: white;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    outline: none;
  }

  .map-container {
    width: 100%;
    height: 100%;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid #334155;
  }

  #map { width: 100%; height: 100%; }

  aside {
    grid-column: 3;
    height: 100vh;
    background: #141827;
    border-left: 1px solid #334155;
    display: flex;
    flex-direction: column;
    z-index: 5;
  }

  .sidebar-header {
    padding: 20px;
    border-bottom: 1px solid #334155;
  }

  .filter-group {
    display: flex;
    justify-content: space-around;
  }

  .check-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: #9ca3af;
    font-size: 10px;
    cursor: pointer;
  }

  #aside-dynamic-content {
    flex: 1;
    overflow-y: auto !important;
    padding: 15px;
  }

  .site-card {
    display: flex;
    gap: 12px;
    background: #1e2533;
    border-radius: 12px;
    padding: 10px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: 0.2s;
    border: 1px solid transparent;
  }

  .site-card:hover {
    background: #2b3447;
    transform: translateX(-5px);
    border-color: #6366f1;
  }

  .site-card img { width: 60px; height: 60px; border-radius: 8px; object-fit: cover; }
  .card-info h4 { color: white; margin: 0; font-size: 14px; }
  .card-info p { color: #9ca3af; font-size: 12px; margin: 4px 0 0; }

  #aside-dynamic-content::-webkit-scrollbar { width: 6px; }
  #aside-dynamic-content::-webkit-scrollbar-thumb { background: #6366f1; border-radius: 10px; }
</style>

<main class="explorer-container">
  <div class="map-search-overlay">
    <input type="text" id="searchInput" placeholder="Rechercher un site..." />
  </div>
  <div class="map-container">
    <div id="map"></div>
  </div>
</main>

<aside>
  <div class="sidebar-header">
    <div class="filter-group">
      <label class="check-item">
        <input type="checkbox" id="checkNormal" checked />
        <span>NORMAL</span>
      </label>
      <label class="check-item">
        <input type="checkbox" id="checkVisites" />
        <span>VISITÉS</span>
      </label>
      <label class="check-item">
        <input type="checkbox" id="checkMarques" />
        <span>MARQUÉS</span>
      </label>
    </div>
  </div>

  <div id="aside-dynamic-content">
    @each(unesco in unescos)
      @if(unesco.coordinates)
        <div class="site-card" onclick="zoomToLocation({{ unesco.coordinates.lon }}, {{ unesco.coordinates.lat }})">
          <img src="{{ unesco.mainImageUrl }}" />
          <div class="card-info">
            <h4>{{ unesco.nameFr }}</h4>
            <p>{{ unesco.statesNames }}</p>
          </div>
        </div>
      @end
    @end
  </div>
</aside>

<script>
  const unescosData = {{{ JSON.stringify(unescos) }}};
  mapboxgl.accessToken = "pk.eyJ1IjoiNjdza2liaWRpc2NydW0iLCJhIjoiY21sYXdlamR3MGcyOTNlcXoxdHQ2bXliaiJ9.BXx6EzzxvsFrDg5yeo1LUQ";

  const map = new mapboxgl.Map({
    container: "map",
    style: "mapbox://styles/mapbox/standard",
    projection: "globe",
    zoom: 1.8,
    center: [10, 20]
  });

  let markerInstances = [];
  let rainbowEnabled = false;

  // --- FILTRAGE AMÉLIORÉ ---
  function filterContent() {
    const searchTerm = document.getElementById("searchInput").value.toLowerCase();

    // On récupère l'état des filtres (si tu as des propriétés isVisited ou isFavorite dans tes données)
    const showNormal = document.getElementById("checkNormal").checked;
    const showVisites = document.getElementById("checkVisites").checked;
    const showMarques = document.getElementById("checkMarques").checked;

    const filteredData = unescosData.filter(item => {
      const name = item.nameFr ? item.nameFr.toLowerCase() : "";
      const states = item.statesNames ? item.statesNames.toLowerCase() : "";

      // Filtre textuel
      const matchesSearch = name.includes(searchTerm) || states.includes(searchTerm);

      // Filtre par catégorie (Si tu as ces champs en base, sinon ignore cette partie)
      // let matchesCategory = true;
      // if (!showNormal && !item.isVisited && !item.isFavorite) matchesCategory = false;

      return matchesSearch;
    });

    updateMarkers(filteredData);
    updateAside(filteredData);
  }

  function updateMarkers(data) {
    markerInstances.forEach(m => m.remove());
    markerInstances = [];

    data.forEach(h => {
      if (h.coordinates && h.coordinates.lon && h.coordinates.lat) {
        const marker = new mapboxgl.Marker({ color: "#61afef" })
          .setLngLat([parseFloat(h.coordinates.lon), parseFloat(h.coordinates.lat)])
          .addTo(map);
        markerInstances.push(marker);
      }
    });
  }

  function updateAside(data) {
    const content = document.getElementById("aside-dynamic-content");
    content.innerHTML = ''; // On vide la liste

    data.forEach(u => {
      if (!u.coordinates) return;

      const card = document.createElement('div');
      card.className = 'site-card';

      // Correction du clic : on passe directement les coordonnées de l'objet u
      card.onclick = () => zoomToLocation(u.coordinates.lon, u.coordinates.lat);

      card.innerHTML = `
        <img src="${u.mainImageUrl}" alt="${u.nameFr}" />
        <div class="card-info">
          <h4>${u.nameFr || 'Sans nom'}</h4>
          <p>${u.statesNames || 'Lieu inconnu'}</p>
        </div>`;
      content.appendChild(card);
    });
  }

  function zoomToLocation(lng, lat) {
    map.flyTo({
        center: [parseFloat(lng), parseFloat(lat)],
        zoom: 12,
        duration: 3500,
        essential: true
    });
  }

  const konamiCode = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"];
  let konamiIndex = 0;

  window.addEventListener("keydown", e => {
    if (e.key === konamiCode[konamiIndex]) {
      konamiIndex++;
      if (konamiIndex === konamiCode.length) {
        rainbowEnabled = !rainbowEnabled;
        konamiIndex = 0;
      }
    } else { konamiIndex = 0; }
  });

  function rainbowColor() {
    const t = Date.now() / 1000;
    const hue = (t % 5) * 360 / 5;
    return `hsl(${hue}, 100%, 50%)`;
  }

  map.on("style.load", () => {
    function animate() {
      map.setFog({
        range: [0.5, 10],
        color: rainbowEnabled ? rainbowColor() : "white",
        "high-color": "#245cdf",
        "space-color": "#000000"
      });
      requestAnimationFrame(animate);
    }
    animate();
  });

  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("searchInput").addEventListener("input", filterContent);

    ['checkNormal', 'checkVisites', 'checkMarques'].forEach(id => {
      const el = document.getElementById(id);
      if(el) el.addEventListener('change', filterContent);
    });
  });

  map.on("load", () => {
    map.resize();
    filterContent(); // Premier filtrage pour afficher les données au chargement
  });
</script>
@end
