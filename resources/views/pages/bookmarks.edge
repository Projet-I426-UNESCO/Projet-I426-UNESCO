@layout('components/layout/index', { title: 'Sites visits', page: 'visits' })
  <!--TODO : ajouter les filtres(par date cr/decr, par pays, par nom cr/decr ) et la recherche-->
  <main class="sites-main">
    <div class="controls">
      <div class="search-container">
        @include('components/search/site_search')
      </div>
    </div>
    <div class="sites-grid">
    </div>
    <div id="filterPopup" class="filter-popup">
      <div class="filter-popup-content">
        <div class="filter-popup-header">
          <h2>
            Filtres
          </h2>
          <button class="filter-close-btn" onclick="closeFilters()">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <div class="filter-popup-body">
          <div class="filter-section">
            <label>Région / Pays</label>
            <input type="text" id="countryFilter" placeholder="Rechercher un pays..." />
          </div>
          <div class="filter-section">
            <label>Type de site</label>
            <select id="typeFilter">
              <option value="">
                Tous les types
              </option>
              <option value="cultural">
                Culturel
              </option>
              <option value="natural">
                Naturel
              </option>
              <option value="mixed">
                Mixte
              </option>
            </select>
          </div>
          <select id="increase">
            <option value="increase">
              Croisant
            </option>
            <option value="decrease">
              Décroisant
            </option>
          </select>
        </div>
        <div class="filter-popup-footer">
          <button class="btn-primary" onclick="applyFilters()">Appliquer</button>
          <button class="btn-secondary" onclick="resetFilters()">Réinitialiser</button>
        </div>
      </div>
    </div>

    <div class="sites-grid">
      @if(unescos && unescos.length > 0)
        @each((unesco) in unescos)
          @let(marker = markers.find(m => m.unescoId == unesco.id))
          <div class="site-box" data-id="{{ unesco.id }}">

            <a href="{{ route('site.show', { id: unesco.id }) }}">
              @if(unesco.localImageThumb)
                <img src="{{ unesco.localImageMain }}" class="site-box-img" />
              @else
                <img src="../../../public/placeholders/placeholderImage.png" class="site-box-img" />
              @end
              <div class="site-box-info">
                <h3>
                  {{ i18n.locale === 'en' ? (unesco.nameEn || unesco.nameFr) : (unesco.nameFr || unesco.nameEn) }}
                </h3>
                <p>
                  {{ unesco.statesNames }}
                </p>
              </div>
            </a>

            <div class="add_button">
              <button
                class="btn-primary"
                id="visitSiteBtn{{ unesco.id }}"
                onclick="visitSite('{{ route('marker.visit', { unescoId: unesco.id }) }}', {{ unesco.id }})"
              >
                @if(marker && marker.isVisited)
                  {{ t('messages.home.remove_from_visited') }}
                @else
                  {{ t('messages.home.add_to_visited') }}
                @end
              </button>
              <button
                class="btn-primary button_mark"
                id="markSiteBtn{{ unesco.id }}"
                onclick="markSite('{{ route('marker.mark', { unescoId: unesco.id }) }}', {{ unesco.id }})"
              >                <span>
                  <span>{{ t('messages.home.unmark_site') }}</span></button>
              </div>
            </div>
          @end
        @else
          <p class="no_site">
            {{ t('messages.home.no_marked_sites') }}
          </p>
        @end
      </div>
    </main>
    <script type="module">
      import { initSiteSearch } from "./resources/views/components/js/siteSearch.js";
      initSiteSearch({
        unescos: unescosData,
        markers: markersData,
        onUpdate: (filtered) => {
          const visibleIds = new Set(filtered.map(u => u.id));

          document.querySelectorAll(".site-box").forEach(box => {
            const id = Number(box.dataset.id);
            box.style.display = visibleIds.has(id) ? "" : "none";
          });
        }
      });
    </script>
    <script>
      function openFilters() {
        const popup = document.getElementById("filterPopup");
        popup.classList.add("show");
      }

      function closeFilters() {
        const popup = document.getElementById("filterPopup");
        popup.classList.remove("show");
      }

      function applyFilters() {
        const countryFilter = document.getElementById("countryFilter").value;
        const typeFilter = document.getElementById("typeFilter").value;
        const sites = document.querySelectorAll(".site-box");
        sites.forEach(site => {
          let visible = true;
          if (countryFilter) {
            const country = site.querySelector(".site-box-info p").textContent.toLowerCase();
            visible = visible && country.includes(countryFilter.toLowerCase());
          }
          site.style.display = visible ? "flex" : "none";
        });
        closeFilters();
      }

      function resetFilters() {
        document.getElementById("countryFilter").value = "";
        document.getElementById("typeFilter").value = "";
        const sites = document.querySelectorAll(".site-box");
        sites.forEach(site => {
          site.style.display = "flex";
        });
        closeFilters();
      }

      document.getElementById("filterPopup").addEventListener("click", function(e) {
        if (e.target === this) {
          closeFilters();
        }
      });

      const csrfToken = "{{ csrfToken }}";

      const unescosData = {{{ JSON.stringify(unescos) }}};
      const markersData = {{{ JSON.stringify(markers) }}};

      async function visitSite(url, unescoId) {
        try {
          const res = await fetch(url, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "x-csrf-token": csrfToken
            }
          });
          if (!res.ok) throw new Error("Request failed");
          console.log(`Visiting sequence with unescoId : ${unescoId} `);
          flipVisitSiteUI(unescoId);
        } catch (err) {
          console.error(err);
        }
      }

      async function markSite(url, unescoId) {
        try {
          const res = await fetch(url, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "x-csrf-token": csrfToken
            }
          });
          if (!res.ok) throw new Error("Request failed");
          console.log(`Marking sequence with unescoId : ${unescoId} `);
          flipMarkSiteUI(unescoId);
        } catch (err) {
          console.error(err);
        }
      }

      function flipVisitSiteUI(unescoId) {
        // if the marker exists Flip the isVisited value in UI
        if (markersData) {
          const marker = markersData.find(marker => marker.unescoId == unescoId);
          const button = document.getElementById("visitSiteBtn" + unescoId);
          console.log(button);
          if (marker) {
            markersData[markersData.findIndex(marker => marker.unescoId == unescoId)].isVisited = !marker.isVisited;
            button.innerText = marker.isVisited ? "{{ t('messages.home.remove_from_visited') }}" : "{{ t('messages.home.add_to_visited') }}";
            // Flips the isVisited in the gotten data, it modifies the now local data, not the distant one, simply to keep the UI up to date.
          } else {
            markersData.push({
              isMarked: 0,
              isVisited: 1,
              unescoId: unescoId
            });
            button.innerText = "{{ t('messages.home.remove_from_visited') }}";
          }
        }
      }

      function flipMarkSiteUI(unescoId) {
        // if the marker exists Flip the isMarked value in UI
        if (markersData) {
          const marker = markersData.find(marker => marker.unescoId == unescoId);
          const button = document.getElementById("markSiteBtn" + unescoId);
          console.log(button);
          if (marker) {
            markersData[markersData.findIndex(marker => marker.unescoId == unescoId)].isMarked = !marker.isMarked;
            button.innerText = marker.isMarked ? "{{ t('messages.home.unmark_site') }}" : "{{ t('messages.home.mark_site') }}";
            // Flips the isMarked in the gotten data, it modifies the now local data, not the distant one, simply to keep the UI up to date.
          } else {
            // If the marker doesn't exist we manually, locally create it as the db would and change it's values manually
            markersData.push({
              isMarked: 1,
              isVisited: 0,
              unescoId: unescoId
            });
            button.innerText = "{{ t('messages.home.unmark_site') }}";
          }
        }
      }
    </script>
  @end
